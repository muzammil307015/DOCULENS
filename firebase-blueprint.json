{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal/organization details and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the document path",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User full name or display handle",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 1024
        },
        "company": {
          "type": "string",
          "description": "Company, university, or organization name",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "description": "Primary role or title",
          "maxLength": 120
        },
        "sector": {
          "type": "string",
          "description": "Industry sector or domain",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile update",
          "maxLength": 64
        }
      },
      "required": ["userId", "email"]
    },
    "UserAnalysis": {
      "title": "UserAnalysis",
      "description": "Full document intelligence analysis result belonging to a specific user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique analysis ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "docId": {
          "type": "string",
          "description": "Associated document ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Document analysis title",
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "description": "Document category",
          "maxLength": 64
        },
        "analyzedAt": {
          "type": "string",
          "description": "ISO timestamp when analysis completed",
          "maxLength": 64
        },
        "executiveSummary": {
          "type": "string",
          "description": "Executive summary text",
          "maxLength": 30000
        }
      },
      "required": ["id", "userId", "title"]
    },
    "UserDocument": {
      "title": "UserDocument",
      "description": "Parsed document metadata and extracted content",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "fileName": {
          "type": "string",
          "description": "Original file name",
          "maxLength": 256
        },
        "fileSizeBytes": {
          "type": "number",
          "description": "File size in bytes"
        },
        "detectedFormat": {
          "type": "string",
          "description": "Detected file extension/format",
          "maxLength": 32
        },
        "uploadedAt": {
          "type": "string",
          "description": "ISO timestamp of upload",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "fileName"]
    },
    "UserEvidence": {
      "title": "UserEvidence",
      "description": "Evidence document in user vault",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Evidence item ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Evidence title",
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "description": "Category",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title"]
    },
    "UserMemory": {
      "title": "UserMemory",
      "description": "User document memory clause for reuse across analyses",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Memory clause ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Clause title",
          "maxLength": 256
        },
        "snippet": {
          "type": "string",
          "description": "Clause text snippet",
          "maxLength": 5000
        }
      },
      "required": ["id", "userId", "title"]
    },
    "UserChatSession": {
      "title": "UserChatSession",
      "description": "Q&A and conversation history for document intelligence",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Chat session ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "docId": {
          "type": "string",
          "description": "Document ID if tied to a document",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Chat session title",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User private profile document"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "UserAnalysis",
      "description": "Private analyses created by the authenticated user"
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": "UserDocument",
      "description": "Private parsed documents for the authenticated user"
    },
    "/users/{userId}/evidence/{evidenceId}": {
      "schema": "UserEvidence",
      "description": "Private evidence records in user vault"
    },
    "/users/{userId}/memory/{memoryId}": {
      "schema": "UserMemory",
      "description": "Private document memory bank items"
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": "UserChatSession",
      "description": "Private chat and Q&A history sessions"
    }
  }
}

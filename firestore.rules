rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Hierarchical subcollections: strictly scoped to the parent user
      match /analyses/{analysisId} {
        allow read, write: if isOwner(userId) && isValidId(analysisId);
      }

      match /documents/{documentId} {
        allow read, write: if isOwner(userId) && isValidId(documentId);
      }

      match /evidence/{evidenceId} {
        allow read, write: if isOwner(userId) && isValidId(evidenceId);
      }

      match /memory/{memoryId} {
        allow read, write: if isOwner(userId) && isValidId(memoryId);
      }

      match /chat_sessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);
        
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isValidId(messageId);
        }
      }

      match /checklists/{checklistId} {
        allow read, write: if isOwner(userId) && isValidId(checklistId);
      }
    }

    // Top-level collections with explicit resource.data.userId verification
    match /analyses/{analysisId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /evidenceDocuments/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /memoryEntries/{entryId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /chatSessions/{sessionId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
